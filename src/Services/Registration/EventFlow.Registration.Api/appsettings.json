{
  "ConnectionStrings": {
    "RegistrationDatabase": "Host=localhost;Port=5432;Database=RegistrationDatabase;Username=postgres;Password=<SET_IN_USER_SECRETS>"
  },
  "Jwt": { 
    "Issuer": "EventFlow.Identity",
    "Audience": "EventFlow",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Registration": {
    "EventAccess": {
      "AllowAll": false
    }
  },
  "Cors": { "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ] },
  "AllowedHosts": "*"
}