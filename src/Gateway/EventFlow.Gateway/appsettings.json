{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },

      "event-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/events/{**catch-all}"
        }
      },

      "event-settings-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/events-settings/{**catch-all}"
        }
      },
      "section-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/section/{**catch-all}"
        }
      },
      "session-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/session/{**catch-all}"
        }
      },
      "event-page-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/event-page/{**catch-all}"
        }
      },
      "page-section-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/page-section/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "https://localhost:7001/"
          }
        }
      },

      "event-cluster": {
        "Destinations": {
          "event-api": {
            "Address": "https://localhost:7002/"
          }
        }
      }
    }
  }
}