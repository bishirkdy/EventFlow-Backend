{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },

      "event-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/events/{**catch-all}"
        }
      },

      "event-settings-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/events-settings/{**catch-all}"
        }
      },

      "section-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/section/{**catch-all}"
        }
      },

      "session-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/session/{**catch-all}"
        }
      },

      "event-page-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/event-page/{**catch-all}"
        }
      },

      "page-section-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/page-section/{**catch-all}"
        }
      },

      "navigation-items-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/navigation-items/{**catch-all}"
        }
      },

      "navigation-menu-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/navigation-menu/{**catch-all}"
        }
      },

      "event-type-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/event-type/{**catch-all}"
        }
      },

      "registration-form-route": {
        "ClusterId": "registration-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/events/{eventId}/registration-form/{**catch-all}"
        }
      },

      "registration-route": {
        "ClusterId": "registration-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/events/{eventId}/registrations/{**catch-all}"
        }
      },

      "participant-route": {
        "ClusterId": "registration-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/events/{eventId}/participants/{**catch-all}"
        }
      },

      "ticket-route": {
        "ClusterId": "registration-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/events/{eventId}/tickets/{**catch-all}"
        }
      }

    },

    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "https://localhost:7001/"
          }
        }
      },

      "event-cluster": {
        "Destinations": {
          "event-api": {
            "Address": "https://localhost:7002/"
          }
        }
      },
      "registration-cluster": {
        "Destinations": {
          "registration-api": {
            "Address": "https://localhost:7003/"
          }
        }
      }
    }
  }
}